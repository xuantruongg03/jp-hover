{
  "manifest_version": 3,
  "name": "JP Furigana Hover - Phiên âm Tiếng Nhật",
  "version": "1.0.0",
  "description": "Rê chuột để hiển thị tức thì phiên âm tiếng Nhật (Hiragana, Romaji, Hán-Việt, Nghĩa từ, Phát âm). Phím tắt Alt+J bật/tắt nhanh.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "JP Furigana Hover",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "commands": {
    "toggle-hover": {
      "suggested_key": {
        "default": "Alt+J",
        "mac": "Alt+J"
      },
      "description": "Bật / Tắt nhanh chế độ phiên âm tiếng Nhật"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "data/kanji_hanviet.js",
        "content/romaji.js",
        "data/dictionary.js",
        "content/engine.js",
        "content/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/tooltip.css",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
