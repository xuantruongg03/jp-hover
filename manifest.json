{
  "manifest_version": 3,
  "name": "JP Furigana Hover - Phiên âm & Học Tiếng Nhật Pro",
  "version": "1.6.4",
  "description": "Rê chuột hiển thị Furigana, Hán-Việt, Nét vẽ Kanji, Dịch câu, Phụ đề YouTube/Netflix, AnkiConnect & SRS Flashcard.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "JP Furigana Hover Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1:*/*",
    "http://localhost:*/*",
    "https://*/*"
  ],
  "commands": {
    "toggle-hover": {
      "suggested_key": {
        "default": "Alt+J",
        "mac": "Alt+J"
      },
      "description": "Bật / Tắt nhanh chế độ phiên âm tiếng Nhật"
    },
    "quick-search": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Mở thanh tra cứu nhanh tiếng Nhật (Quick Search)"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "utils/helpers.js",
        "utils/storage.js",
        "utils/ai_service.js",
        "utils/audio.js",
        "utils/anki.js",
        "utils/kanji_strokes.js",
        "data/kanji_hanviet.js",
        "content/romaji.js",
        "data/grammar_rules.js",
        "data/dictionary_expanded.js",
        "data/dictionary.js",
        "content/engine.js",
        "content/subtitles.js",
        "content/quick_search.js",
        "content/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/tooltip.css",
        "icons/*",
        "flashcards.html",
        "flashcards.css",
        "flashcards.js",
        "data/*",
        "utils/ai_service.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
